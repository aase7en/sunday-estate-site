# Sunday Estate marketing site — environment variables
# Copy to .env.local and fill in. Never commit .env.local.

# Mapbox GL — needed for the Property Map section (M3).
# Get one at https://account.mapbox.com/access-tokens/
# Restrict to: localhost, sundayestate.co.th, *.pages.dev (CF Pages previews)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Resend — contact form (M4).
# https://resend.com/api-keys
RESEND_API_KEY=
CONTACT_TO_EMAIL=aase7en@sunday-estate.com
